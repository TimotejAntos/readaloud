# Copy this file to pc-worker/.env (same folder) and fill in both values.
# .env is ignored by git, so the key never leaves this PC.
#
# Where to find them:
#   supabase.com -> your project -> Project Settings -> API Keys
#   - Project URL
#   - "service_role" (legacy tab) or a "secret" key -> Reveal -> Copy
# The service role key can read and write everything. Keep it on this PC only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Only if ffmpeg is not on PATH:
# FFMPEG_PATH=C:\path\to\ffmpeg.exe
